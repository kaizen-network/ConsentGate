diff --git a/common/src/main/java/ac/grim/grimac/player/TransactionTimeout.java b/common/src/main/java/ac/grim/grimac/player/TransactionTimeout.java
new file mode 100644
index 000000000..7c60f8cf9
--- /dev/null
+++ b/common/src/main/java/ac/grim/grimac/player/TransactionTimeout.java
@@ -0,0 +1,21 @@
+package ac.grim.grimac.player;
+
+/** Tracks the timeout window without changing the transaction clock used by checks. */
+final class TransactionTimeout {
+    private boolean playing;
+    private long playStarted;
+
+    // Called only by the same poller that performs the timeout check.
+    boolean isExpired(boolean inPlay, long now, long acknowledgedAt, long timeoutNanos) {
+        if (!inPlay) {
+            playing = false;
+            return false;
+        }
+        if (!playing) {
+            playing = true;
+            playStarted = now;
+        }
+        // Transactions are not sent outside PLAY. Give each new PLAY phase its own response window.
+        return now - playStarted > timeoutNanos && now - acknowledgedAt > timeoutNanos;
+    }
+}
