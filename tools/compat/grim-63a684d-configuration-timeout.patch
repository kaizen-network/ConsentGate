@@ -0,0 +1,52 @@
+package ac.grim.grimac.player;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class TransactionTimeoutTest {
+    @Test
+    void configurationDoesNotExpire() {
+        TransactionTimeout timeout = new TransactionTimeout();
+        assertFalse(timeout.isExpired(false, 0, 0, 60));
+        assertFalse(timeout.isExpired(false, 120, 0, 60));
+    }
+
+    @Test
+    void longConfigurationDoesNotCauseImmediatePlayTimeout() {
+        TransactionTimeout timeout = new TransactionTimeout();
+        assertFalse(timeout.isExpired(false, 120, 0, 60));
+        assertFalse(timeout.isExpired(true, 125, 0, 60));
+        assertFalse(timeout.isExpired(true, 185, 0, 60));
+        assertTrue(timeout.isExpired(true, 186, 0, 60));
+    }
+
+    @Test
+    void acknowledgmentsKeepConnectionAliveWithoutDisablingLaterTimeout() {
+        TransactionTimeout timeout = new TransactionTimeout();
+        assertFalse(timeout.isExpired(true, 0, 0, 60));
+        assertFalse(timeout.isExpired(true, 100, 90, 60));
+        assertFalse(timeout.isExpired(true, 150, 90, 60));
+        assertTrue(timeout.isExpired(true, 151, 90, 60));
+    }
+
+    @Test
+    void reconfigurationStartsAnotherBoundedWindow() {
+        TransactionTimeout timeout = new TransactionTimeout();
+        assertFalse(timeout.isExpired(true, 0, 0, 60));
+        assertFalse(timeout.isExpired(false, 40, 30, 60));
+        assertFalse(timeout.isExpired(false, 200, 30, 60));
+        assertFalse(timeout.isExpired(true, 201, 30, 60));
+        assertTrue(timeout.isExpired(true, 262, 30, 60));
+    }
+
+    @Test
+    void elapsedTimeHandlesNanoTimeWraparound() {
+        TransactionTimeout timeout = new TransactionTimeout();
+        long start = Long.MAX_VALUE - 10;
+        assertFalse(timeout.isExpired(true, start, start, 60));
+        assertFalse(timeout.isExpired(true, start + 60, start, 60));
+        assertTrue(timeout.isExpired(true, start + 61, start, 60));
+    }
+}
